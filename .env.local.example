# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never contain real credentials.

# Supabase — project URL and the publishable (anon) key.
# The publishable key is safe to expose to the browser: every table has RLS
# enabled, so it can only ever read rows the signed-in user owns.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Server-only. Bypasses RLS entirely — never expose to the client, and always
# filter by user_id by hand in any code path that uses it.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Phase 1+: summarization and chat.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Phase 1+: embeddings via Vercel AI Gateway (cohere/embed-v4.0 @ 1024 dims).
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here

# Phase 1+: content extraction.
JINA_API_KEY=jina_your_key_here
